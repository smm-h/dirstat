{
  "targets": [
    "go"
  ],
  "pipelines": {
    "go": {
      "type": "go",
      "local": true,
      "install_paths": [
        "."
      ]
    }
  },
  "private": false,
  "hooks": {
    "pre_release": [
      "go vet ./...",
      "go build -o /dev/null .",
      "go test ./... -race -count=1"
    ]
  },
  "coverage_unit": "commit"
}

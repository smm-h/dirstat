      "language": "go"
    },
    {
      "path": "internal/classify",
      "language": "go"
    },
    {
      "path": "internal/config",
      "language": "go"
    },
    {
      "path": "internal/jsonout",
      "language": "go"
    },
    {
      "path": "internal/render",
      "language": "go"
    },
    {
      "path": "internal/scan",
      "language": "go"
    }
  ],
